{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./AGENTS.md"
  ],
  "plugin": [
    "opencode-wakatime",
    "opencode-helicone-session",
    "@dietrichgebert/ponytail",
    ".opencode/plugins/graphify.js",
    ".opencode/plugins/spaceapps-harness.js"
  ],
  "permission": {
    "bash": {
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "playwright *": "allow",
      "ctx7 *": "allow",
      "npx *": "allow",
      "*": "ask"
    },
    "edit": "allow",
    "webfetch": "allow"
  },
  "formatter": true,
  "snapshot": true,
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 60000
  }
}