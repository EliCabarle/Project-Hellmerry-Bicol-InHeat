    "slope": 0.156949,
    "intercept": 33.27864,
    "significant": false
  },
  "analysis_b_volatility": {
    "pearson_r": 0.444801,
    "p_value": 0.002203,
    "r_squared": 0.197848,
    "slope": 0.094113,
    "intercept": 0.651497,
    "significant": true
  },
  "regression_formula": "annual_mean_heat = 0.1569 * ONI + 33.2786",
  "interpretation": "Positive ONI (El Niño) correlates with higher Bicol mean heat and volatility."
}