# Copy to .env at the repo root and fill in. Never commit .env.
# The web client only ever sees VITE_* values; everything else stays server-side.

# --- Public client config (read by apps/web, shipped in the bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-side scripts + POST /api/qa) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Some scripts read this alias for the same service-role key.
SUPABASE_SERVICE_KEY=

# --- QA chatbot (server-side only) ---
GEMINI_API_KEY=
GROQ_API_KEY=
CHAT_MODEL=
CHAT_MODEL_FALLBACK=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- ETL (only needed when running Earthdata pulls) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
FIRMS_MAP_KEY=

# --- Optional validation source ---
CDO_API_TOKEN=
