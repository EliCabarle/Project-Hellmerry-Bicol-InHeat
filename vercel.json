{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "bicol-in-heat-api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "bicol-in-heat-api" }
    },
    {
      "source": "/health",
      "destination": { "service": "bicol-in-heat-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
